# KILN virtual computer image — every pinned input, in one place.
# Bump a version AND its sha256 together; the Dockerfile verifies each
# download against the hash here and fails the build on a mismatch.
# Hashes recorded 2026-11-25 from the publishers' own checksum files
# (Node SHASUMS256, gh checksums.txt, bun SHASUMS256, rustup .sha256) or,
# where none is published (Chrome for Testing zip, Agave tarball), by
# downloading the artifact once and hashing it.

KILN_VC_IMAGE_VERSION=1.0.0

# Base image (tag + digest) and the Debian snapshot apt resolves against,
# so `apt-get install` sees the same package versions on every build.
BASE_IMAGE=debian:trixie-slim@sha256:8aa5a7bf5a1955bddbe7d74fcdd0b91ab30e74362a8b73af672b0481b35b44a0
DEBIAN_SNAPSHOT=20261125T000000Z

NODE_VERSION=24.22.3
NODE_SHA256=4f2b175a6d53a5c617a80dba2676238a0688cef28c6da4eba35c7d844e66fcfb
PNPM_VERSION=10.34.6
BUN_VERSION=1.4.4
BUN_SHA256=bf8ccbfb2b0b80159e0f9a6d15c55317add8077534dbc6130a3edb52fccb395c

GH_VERSION=2.103.0
GH_SHA256=fdd768eb70f6409f80fcfa9f3a1c0adf0fc98d827ab3ce0bed2ac22762c5d786

RUSTUP_VERSION=1.28.2
RUSTUP_SHA256=20a06e644b0d9bd2fbdbfd52d42540bdde820ea7df86e92e533c073da0cdd43c
# 1.79.0 on purpose: anchor-cli 0.30.1 does not compile on rustc >= 1.80
# (the `time` crate inference break). Matches PARRALAX-AIHFTFUND/solana.
RUST_TOOLCHAIN=1.79.0

SOLANA_VERSION=1.18.26
SOLANA_SHA256=913c3fd7d9ac22b0a002dd2a691433176cc153e8839790589eba492d095f6d97
ANCHOR_VERSION=0.30.1

CHROME_VERSION=158.0.8127.88
CHROME_SHA256=59e3b43f8b3aaa292238fbdcfb36a93127debd53e212510dcdc2cc8812b4b57e
