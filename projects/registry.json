{
  "schema": "kiln.project-registry.v1",
  "destination": "ItsNotAILABS/KILN",
  "projects": [
    {
      "id": "kiln-workspace",
      "name": "KILN Workspace",
      "repository": "ItsNotAILABS/kiln-workspace",
      "role": "Live Kiln forge app shared by Grok Build and Codex. Custom domain later (kiln.medinatechlabs.net).",
      "defaultBranch": "main",
      "workspace": "kiln-forge",
      "mcp": { "endpoint": "http://127.0.0.1:8080", "mode": "app" },
      "lanes": { "grok": "grok/work", "codex": "codex/work" },
      "livePreview": "https://kiln-git.grok.me/",
      "local": ["E:\\\\KILN", "E:\\\\workspaces\\\\kiln-codex"],
      "capabilities": ["web", "git", "studio", "mcp", "preview"]
    },
    {
      "id": "pocket",
      "name": "POCKET",
      "repository": "ItsNotAILABS/pocket",
      "role": "Native Agent OS — habitat, screen, PhoneAI, MCP, registry — already in the KILN ecosystem",
      "defaultBranch": "main",
      "workspace": "pocket-os",
      "mcp": { "endpoint": "http://127.0.0.1:8787", "mode": "host" },
      "capabilities": ["python", "phoneai", "mcp", "screen", "vision", "registry", "voice", "agent", "receipts", "release"],
      "family": ["ItsNotAILABS/pocket-agent", "ItsNotAILABS/pocket-voice-to-text", "ItsNotAILABS/PhoneAI", "ItsNotAILABS/pocket-mailbox"]
    },
    {
      "id": "pocket-mailbox",
      "name": "POCKET Mailbox",
      "repository": "ItsNotAILABS/pocket-mailbox",
      "role": "First-class agent mailbox — threads, search, archive — agents.pocket.local",
      "defaultBranch": "main",
      "workspace": "pocket-mailbox",
      "mcp": { "endpoint": "http://127.0.0.1:8792", "mode": "host" },
      "capabilities": ["mail", "python", "threads", "receipts"]
    },
    {
      "id": "capsulabuilder",
      "name": "CapsulaBuilder",
      "repository": "ItsNotAILABS/CapsulaBuilder",
      "role": "MonadBuilder+ web and THESIS Agent Desktop",
      "defaultBranch": "main",
      "workspace": "monadbuilder-thesis",
      "mcp": { "endpoint": "http://127.0.0.1:8081", "mode": "governed-local" },
      "capabilities": ["web", "desktop", "mcp", "contracts", "monad", "wallet", "receipts", "release"]
    },
    {
      "id": "sovereign-engine",
      "name": "Sovereign Engine",
      "repository": "FreddyCreates/sovereign-engine",
      "role": "Sovereign Engine OS and Sovereign Books substrate",
      "defaultBranch": "main",
      "workspace": "sovereign-books",
      "mcp": { "endpoint": "http://127.0.0.1:8082", "mode": "governed-local" },
      "capabilities": ["python", "books", "agents", "workflows", "mcp", "virtual-computer", "receipts", "release", "finance", "infra"]
    },
    {
      "id": "neurospaceai",
      "name": "NeurospaceAI",
      "repository": "ItsNotAILABS/Neurospaceai",
      "role": "NeuroEmergence Core deep lab and sovereign cognitive architecture",
      "sourceLineage": "FreddyCreates/BRAIN-AI-",
      "defaultBranch": "main",
      "workspace": "neurospaceai-deep-lab",
      "runtime": { "platform": "Internet Computer", "backend": "Motoko", "frontend": "React + TypeScript" },
      "mcp": { "endpoint": "http://127.0.0.1:8084", "mode": "governed-local" },
      "capabilities": ["cognition", "memory", "brain-atlas", "doctrine", "simulation", "economics", "icp-canisters", "react-console"]
    },
    {
      "id": "auro14b",
      "name": "Auro14B",
      "repository": "ItsNotAILABS/Auro14B",
      "role": "Medina native model family — composable checkpoints, micro/core models and governed orchestration lanes on the MESIE compute plane",
      "defaultBranch": "main",
      "workspace": "auro-family",
      "capabilities": ["python", "models", "checkpoints", "orchestration", "receipts", "release"]
    },
    {
      "id": "capsula",
      "name": "CAPSULA",
      "repository": "ItsNotAILABS/CAPSULA",
      "role": "CAPSULA Studio — isolated runtime, build, preview and deployment-plan platform; bounded execution capsules for the POCKET/NEXUS ecosystem",
      "defaultBranch": "main",
      "workspace": "capsula-studio",
      "capabilities": ["web", "typescript", "runtime", "receipts", "release"]
    },
    {
      "id": "sovereign",
      "name": "Sovereign",
      "repository": "FreddyCreates/sovereign",
      "role": "SOVEREIGN application surface (Caffeine project export)",
      "defaultBranch": "main",
      "workspace": "sovereign-app",
      "capabilities": ["web", "typescript"]
    }
  ]
}
